<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- X5（TBS）内核所需权限 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:ignore="MissingPermission" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 应用自己不设定时闹钟，这条是给 TBS 兜底：内核安装失败时它会走
         TbsLogReport → AlarmManager.setExact 上报错误，targetSdk ≥ 31 且
         未声明该权限时那次调用会抛 SecurityException 并杀掉整个进程。
         Android 13+ 该权限默认不授予，不会弹窗打扰用户，也不影响正常启动。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".FireflyApplication"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FireflyTV"
        android:usesCleartextTraffic="true">

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置 Activity - 修复：添加正确的路径 -->
        <activity
            android:name=".ui.screens.SettingsActivity"
            android:exported="false"
            android:hardwareAccelerated="true" />

    </application>

</manifest>